# Copy to .env and uncomment what you need. Everything has a sensible default.

# Model servers registered on first start
# OLLAMA_URL=http://localhost:11434
# LMSTUDIO_URL=http://localhost:1234
# LLAMACPP_URL=http://localhost:8080

# Web search (Beagle). Self-hosted Firecrawl by default; a cloud key switches to Firecrawl cloud.
# FIRECRAWL_URL=http://localhost:3002
# FIRECRAWL_API_KEY=

# Debate defaults
# LLC_MAX_ROUNDS=3
# LLC_MIN_ROUNDS=2
# LLC_NUM_CTX=8192
# LLC_MEMORY_RESERVE_GB=8
# LLC_RESEARCH_PER_ROUND=3

# Timeouts (seconds)
# LLC_REQUEST_TIMEOUT=600
# Longest an agent's turn may take (seconds), and most it may write (tokens, thinking included)
# LLC_TURN_MAX_SECONDS=240
# LLC_TURN_MAX_TOKENS=4096
# Let agents think in every round, not only round 1 (slower)
# LLC_THINK_LATER_ROUNDS=0
# LLC_RESEARCH_TIMEOUT=90

# Backend port (also change frontend/vite.config.js if you do)
# LLC_PORT=8002
# LLC_DB_PATH=data/council.db
